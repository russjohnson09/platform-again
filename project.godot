; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Platform Again"
config/version="1.0.0"
run/main_scene="uid://rv2d8cp1blv3"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/image="uid://c08t4gvohrdvp"
config/icon="uid://c08t4gvohrdvp"

[audio]

buses/default_bus_layout="uid://b8wr0hwoqop4v"
driver/enable_input=true

[autoload]

DebugMenu="*uid://cggqb75a8w8r"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"

[editor_plugins]

enabled=PackedStringArray("res://addons/debug_menu/plugin.cfg", "res://addons/direct_audio_and_wav_24bits/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
